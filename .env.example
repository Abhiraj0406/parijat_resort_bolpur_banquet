# ==============================================================================
# PARIJAT RESORT BOLPUR & BANQUET - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your project root:
#    cp .env.example .env
# 2. Update the credentials below to match your local or production environment.
# 3. NEVER commit the actual '.env' file to your Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Parijat Resort Bolpur"
# Environment: 'development' (shows errors), 'staging', or 'production' (hides errors, logs to file)
APP_ENV=development
# Debug mode: true (development) or false (live subdomain / production)
APP_DEBUG=true
# Base URL of the website without trailing slash
# Local:      http://localhost/parijat_resort_bolpur_banquet
# Subdomain:  https://resort.yourdomain.com
# Production: https://parijatresortbolpur.com
APP_URL=http://localhost/parijat_resort_bolpur_banquet
# Server timezone
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parijat_resort
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# SMTP / EMAIL SETTINGS (PHPMailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=reservations@parijatresortbolpur.com
SMTP_PASS=YourSecureSmtpPasswordHere
SMTP_SECURE=tls
FROM_EMAIL=no-reply@parijatresortbolpur.com
FROM_NAME="Parijat Resort Bolpur"
ADMIN_EMAIL=reservations@parijatresortbolpur.com

# ------------------------------------------------------------------------------
# RESORT CONTACT OVERRIDES
# ------------------------------------------------------------------------------
PRIMARY_PHONE="+91 98302 76364"
SECONDARY_PHONE="+91 98309 09875"
WHATSAPP_NUMBER="+91 98309 09875"
MANAGER_PHONE="+91 87775 13554"

# ------------------------------------------------------------------------------
# SECURITY & SESSION SETTINGS
# ------------------------------------------------------------------------------
SESSION_LIFETIME=86400
SESSION_SECURE=auto
