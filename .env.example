# ==============================================================================
# PARIJAT RESORT BOLPUR & BANQUET - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
APP_NAME="Parijat Resort Bolpur & Banquet"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://resort.yourdomain.com
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Live MySQL / Hostinger / cPanel)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u463638053_parijat_b_r
DB_USER=u463638053_parijat_b_r
DB_PASS=YOUR_HOSTINGER_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# SMTP EMAIL SETTINGS (Hostinger Titan Mail / Custom Domain)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=reservations@yourdomain.com
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_SECURE=ssl
FROM_EMAIL=reservations@yourdomain.com
FROM_NAME="Parijat Resort Bolpur"
ADMIN_EMAIL=reservations@yourdomain.com

# ------------------------------------------------------------------------------
# RESORT CONTACT DETAILS 
# ------------------------------------------------------------------------------
PRIMARY_PHONE="+91 6289 309 276"
SECONDARY_PHONE="+91 6289 309 276"
WHATSAPP_NUMBER="+91 6289 309 276"
MANAGER_PHONE="+91 6289 309 276"

# ------------------------------------------------------------------------------
# SECURITY & SESSIONS (Enforced for Production HTTPS)
# ------------------------------------------------------------------------------
SESSION_LIFETIME=86400
SESSION_SECURE=true
